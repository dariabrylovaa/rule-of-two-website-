<section class="section section--alt cta" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <div class="cta__content">
      <% if (locals.eyebrow) { %>
        <p class="eyebrow"><%= eyebrow %></p>
      <% } %>
      <h2 class="cta__title" id="cta-title" data-i18n="cta.title">
        Great things start with two.
      </h2>
      <p class="cta__text" data-i18n="cta.description">
        Bring the vision. We'll bring the expertise.
        Let's build what's next.
      </p>
    </div>

    <a class="button button--primary button--arrow button--block-mobile"
       href="./contact.html"
       data-i18n="common.startProject">
      Start a Project
    </a>
  </div>
</section>
